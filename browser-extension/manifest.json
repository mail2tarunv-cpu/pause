{
  "manifest_version": 3,
  "name": "PAUSE — Attention Bridge",
  "version": "0.1.0",
  "description": "Privately tells PAUSE for Mac which website is currently active, without collecting URLs or titles.",
  "permissions": [
    "tabs",
    "windows",
    "idle",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PAUSE — Attention Bridge",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
